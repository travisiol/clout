# ---------------------------------------------------------------------------
# clout.capital
#
# Everything here is optional. With none of it set the site runs on its bundled
# sample roster and says so on the market page ("Sample roster") — nothing is
# faked silently.
# ---------------------------------------------------------------------------

# The trader leaderboard. Without this the roster is the bundled sample and
# `/api/market` reports source: "seed". A free key (1,000 credits/month) comes
# from https://fomoapi.io/dashboard — every data endpoint there needs one, the
# keyless showcase was closed.
FOMO_API_KEY=
# Override only if you are proxying the upstream.
# FOMO_API_BASE=https://api.fomoapi.io

# Robinhood Chain (id 4663). The public RPC is the default; set this to a
# private endpoint before you take any real traffic.
# NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Which trader owns which share. A curve does not know the X handle it was
# launched for, so the mapping has to be stated. Either put it in
# data/shares.json or inline the same JSON here (for read-only filesystems):
#   { "<handle>": { "token": "0x…", "curve": "0x…", "symbol": "ABC" } }
# With no registry every trader shows "Launch" — which is the truth on a market
# where nothing has been launched.
# SHARE_REGISTRY_JSON=

# Candles, holder lists and trade history need an event index; an RPC node
# cannot enumerate holders or replay CurveBuy/CurveSell. Until this is set
# those three routes answer 501 and name what is missing rather than returning
# an empty list that would read as "no trades".
# INDEXER_URL=

# ETH/USD comes from Coinbase spot. Pin it if you want deterministic figures.
# ETH_USD_OVERRIDE=
